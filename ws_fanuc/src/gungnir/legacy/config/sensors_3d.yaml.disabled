sensors:
  - default_sensor
default_sensor:
  far_clipping_plane_distance: 50
  filtered_cloud_topic: /camera/depth/filtered_points
  image_topic: /camera/depth/image_rect_raw
  max_update_rate: 10
  near_clipping_plane_distance: 0.25
  padding_offset: 0.03
  padding_scale: 1
  queue_size: 5
  sensor_plugin: occupancy_map_monitor/DepthImageOctomapUpdater
  shadow_threshold: 0.2