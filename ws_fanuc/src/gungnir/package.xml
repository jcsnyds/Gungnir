<package format="3">
  <name>gungnir</name>
  <version>0.3.0</version>
  <description>
     An automatically generated package with all the configuration and launch files for using the crx5ia_gripper_camera with the MoveIt Motion Planning Framework
  </description>
  <maintainer email="rpoliquin01@gmail.com">Ryan Poliquin</maintainer>

  <license>BSD</license>

  <url type="website">http://moveit.ai/</url>
  <url type="bugtracker">https://github.com/ros-planning/moveit2/issues</url>
