<?xml version="1.0"?>
<sdf version="1.8">
  <world name="gungnir_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <gravity>0 0 -9.81</gravity>
    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Table: top surface at z = 0 (the same plane as the robot base). Large, so a tilted camera never sees past it -->
    <model name="table"><static>true</static><pose>1.450 0 -0.05 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>4.900 4.0 0.1</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>4.900 4.0 0.1</size></box></geometry>
          <material><ambient>0.65 0.55 0.45 1</ambient><diffuse>0.65 0.55 0.45 1</diffuse></material></visual>
      </link></model>

    <model name="obj0_can"><static>true</static><pose>0.8718 0.0278 0 0 0 1.2748</pose>
      <link name="link">
        <collision name="c0"><pose>0 0 0.0462 0 0 0</pose><geometry><cylinder><radius>0.0300</radius><length>0.0925</length></cylinder></geometry></collision>
        <visual name="v0"><pose>0 0 0.0462 0 0 0</pose><geometry><cylinder><radius>0.0300</radius><length>0.0925</length></cylinder></geometry><material><ambient>0.80 0.15 0.15 1</ambient><diffuse>0.80 0.15 0.15 1</diffuse></material></visual>
      </link></model>
    <model name="obj1_ball"><static>true</static><pose>0.9258 -0.1791 0 0 0 -0.3180</pose>
      <link name="link">
        <collision name="c0"><pose>0 0 0.0348 0 0 0</pose><geometry><sphere><radius>0.0348</radius></sphere></geometry></collision>
        <visual name="v0"><pose>0 0 0.0348 0 0 0</pose><geometry><sphere><radius>0.0348</radius></sphere></geometry><material><ambient>0.15 0.30 0.80 1</ambient><diffuse>0.15 0.30 0.80 1</diffuse></material></visual>
      </link></model>
    <model name="obj2_bottle"><static>true</static><pose>0.8541 0.1925 0 0 0 1.0609</pose>
      <link name="link">
        <collision name="c0"><pose>0 0 0.0400 0 0 0</pose><geometry><cylinder><radius>0.0305</radius><length>0.0800</length></cylinder></geometry></collision>
        <visual name="v0"><pose>0 0 0.0400 0 0 0</pose><geometry><cylinder><radius>0.0305</radius><length>0.0800</length></cylinder></geometry><material><ambient>0.15 0.65 0.25 1</ambient><diffuse>0.15 0.65 0.25 1</diffuse></material></visual>
        <collision name="c1"><pose>0 0 0.1000 0 0 0</pose><geometry><cylinder><radius>0.0120</radius><length>0.0400</length></cylinder></geometry></collision>
        <visual name="v1"><pose>0 0 0.1000 0 0 0</pose><geometry><cylinder><radius>0.0120</radius><length>0.0400</length></cylinder></geometry><material><ambient>0.15 0.65 0.25 1</ambient><diffuse>0.15 0.65 0.25 1</diffuse></material></visual>
      </link></model>
    <model name="obj3_box"><static>true</static><pose>0.9276 0.1368 0 0 0 -1.9015</pose>
      <link name="link">
        <collision name="c0"><pose>0 0 0.0359 0 0 0</pose><geometry><box><size>0.0538 0.0409 0.0718</size></box></geometry></collision>
        <visual name="v0"><pose>0 0 0.0359 0 0 0</pose><geometry><box><size>0.0538 0.0409 0.0718</size></box></geometry><material><ambient>0.90 0.90 0.90 1</ambient><diffuse>0.90 0.90 0.90 1</diffuse></material></visual>
      </link></model>
    <model name="obj4_block"><static>true</static><pose>0.8504 -0.0890 0 0 0 0.1646</pose>
      <link name="link">
        <collision name="c0"><pose>0 0 0.0060 0 0 0</pose><geometry><box><size>0.0973 0.0729 0.0120</size></box></geometry></collision>
        <visual name="v0"><pose>0 0 0.0060 0 0 0</pose><geometry><box><size>0.0973 0.0729 0.0120</size></box></geometry><material><ambient>0.55 0.25 0.70 1</ambient><diffuse>0.55 0.25 0.70 1</diffuse></material></visual>
      </link></model>
  </world>
</sdf>
