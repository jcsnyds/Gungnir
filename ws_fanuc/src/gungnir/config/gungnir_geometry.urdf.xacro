<?xml version="1.0"?>
<!-- AI USE: Section 6 (L515 mount pose and housing offset) was computed with Claude (Anthropic) from
     the Onshape model, the L515 datasheet and the camera's factory extrinsics; values verified by the author. -->
<robot name="crx5ia_gripper_camera" xmlns:xacro="http://ros.org">

  <!-- 1. Include the official FANUC CRX-5iA macro -->
  <xacro:include filename="$(find gungnir)/config/robots/$(arg robot_model)_urdf_macro.xacro"/>

  <!-- 2. Define world link and tool0 flange frame -->
  <link name="world" />
  <link name="tool0" />

  <!-- 3. Instantiate the CRX-5iA robot arm -->
  <!-- Note: The FANUC macro automatically connects the robot flange to 'tool0' -->
  <xacro:call macro="$(arg robot_model)" prefix="" parent="world" child="tool0">
    <origin xyz="0 0 0" rpy="0 0 0" />
  </xacro:call>

  <!-- ===================================================================== -->
  <!-- 4. Pneumatic Gripper (STL in mm -> scale="0.001 0.001 0.001")         -->
  <!-- ===================================================================== -->
  <link name="gripper">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 ${pi/2}" />
      <geometry>
        <mesh filename="package://gungnir/config/meshes/Pneumatic_Gripper_Test.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="gripper_gray">
        <color rgba="0.5 0.5 0.5 1.0" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 ${pi/2}" />
      <geometry>
        <mesh filename="package://gungnir/config/meshes/Pneumatic_Gripper_Test.stl" scale="0.001 0.001 0.001" />
      </geometry>
    </collision>
    <inertial>
      <mass value="1.5" />
      <origin xyz="0 0 0.1" rpy="0 0 ${pi/2}" />
      <inertia ixx="0.005" ixy="0.0" ixz="0.0" iyy="0.005" iyz="0.0" izz="0.002" />
    </inertial>
  </link>

  <joint name="gripper_joint" type="fixed">
    <parent link="tool0" />
    <child link="gripper" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>

  <!-- ===================================================================== -->
  <!-- 5. Tool Center Point (TCP) Frame                                      -->
  <!-- ===================================================================== -->
  <link name="tcp_frame" />

  <joint name="tcp_joint" type="fixed">
    <parent link="tool0" />
    <child link="tcp_frame" />
    <!-- tcp_frame: 0.3 m along the tool axis (tool0 +X). Its z axis is the tool axis; its x and y are
         rotated 180 deg about z relative to camera_depth_optical_frame (this rpy encodes that).
         Adjust the origin to match your physical tool tip. -->
    <origin xyz="0.3 0 0" rpy="${pi/2} 0 ${pi/2}" />
  </joint>

  <!-- ===================================================================== -->
  <!-- 6. Intel RealSense L515 (relative to tool0)                            -->
  <!--    camera_link = the L515 RGB camera's optical centre (x forward).    -->
  <!--    Depth is aligned to colour in l515.py, so every grasp is expressed -->
  <!--    in the RGB frame; camera_depth_optical_frame below therefore marks -->
  <!--    the RGB lens even though its name says "depth".                    -->
  <!--                                                                     -->
  <!--    How the numbers were derived (2026-11-22, with AI assistance):     -->
  <!--      * Depth origin from Onshape ("DEPTH FRAME" mate connector on the -->
  <!--        IR transmitter, 4.5 mm behind the glass per the L515 datasheet -->
  <!--        s3.4), measured from the gripper flange connector:             -->
  <!--        243.424 mm along the tool axis, 63.775 mm toward the camera.   -->
  <!--      * Plus the factory depth-to-colour extrinsics read from this     -->
  <!--        camera with l515_extrinsics.py: RGB centre is +2.809 mm        -->
  <!--        forward, 1.741 mm to image-right, 13.691 mm image-up of the    -->
  <!--        depth origin, rotated by rpy (0.42, -1.71, -0.21) deg.         -->
  <!--    Re-run l515_extrinsics.py if the camera is ever swapped.           -->
  <!-- ===================================================================== -->
  <joint name="l515_mount_joint" type="fixed">
    <parent link="tool0" />
    <child link="camera_link" />
    <!-- xyz: metres in tool0 (x = tool axis, z = toward the camera side). rpy: factory RGB tilt. -->
    <origin xyz="0.246233 -0.001741 0.077466" rpy="0.007408 -0.029885 -0.003665" />
  </joint>

  <link name="camera_link">
    <visual>
      <!-- Housing centre sits 11.8 mm behind and 14.6 mm below the RGB lens (13 mm behind the glass,
           on the housing axis). Cylinder turned so its flat face points along +X. -->
      <origin xyz="-0.011757 0.001591 -0.014608" rpy="0 ${pi/2} 0" />
      <geometry>
        <cylinder radius="0.0305" length="0.026" />
      </geometry>
      <material name="l515_black">
        <color rgba="0.1 0.1 0.1 0.25" />
      </material>
    </visual>
    <collision>
      <!-- Same placement as the visual so MoveIt sees the housing where it really is. -->
      <origin xyz="-0.011757 0.001591 -0.014608" rpy="0 ${pi/2} 0" />
      <geometry>
        <cylinder radius="0.0305" length="0.026" />
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1" />
      <origin xyz="0 0 0" rpy="0 0 0" />
      <inertia ixx="0.00003" ixy="0" ixz="0" iyy="0.00003" iyz="0" izz="0.00005" />
    </inertial>
  </link>

  <!-- Standard ROS Optical Frame (Z forward, X right, Y down) required for depth point clouds -->
  <joint name="camera_depth_optical_joint" type="fixed">
    <parent link="camera_link" />
    <child link="camera_depth_optical_frame" />
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}" />
  </joint>

  <link name="camera_depth_optical_frame" />

</robot>
