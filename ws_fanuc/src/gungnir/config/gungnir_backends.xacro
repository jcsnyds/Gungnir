<?xml version="1.0"?>
<!--
  AI use: this file was written by the project's author (any earlier AI assistance was not recorded here).
  Claude (Anthropic; Claude Opus 5.5 via claude.ai), November 2026, added ONLY the <gpio name="Status"> block
  inside the gungnir_mock macro, after mode:=mock failed with "Can't activate controller
  'joint_trajectory_controller': State interface with key 'Status/collaborative_speed_scaling' does not exist".
  Claude checked that the file is well-formed XML and that the interface names match FANUC's
  ScaledJointTrajectoryController source (fanuc_controllers/src/scaled_joint_trajectory_controller.cpp); it has
  NOT run the mock with ROS 2.
  Reviewed and tested by: not yet reviewed or tested by the author.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="pos_joint" params="name init">
    <joint name="${name}">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">${init}</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>

  <!-- Mock: ros2_control GenericSystem, no physics -->
  <xacro:macro name="gungnir_mock" params="initial_positions_file">
    <xacro:property name="ip" value="${xacro.load_yaml(initial_positions_file)['initial_positions']}"/>
    <ros2_control name="MockSystem" type="system">
      <hardware>
        <plugin>mock_components/GenericSystem</plugin>
      </hardware>
      <xacro:pos_joint name="J1" init="${ip['J1']}"/>
      <xacro:pos_joint name="J2" init="${ip['J2']}"/>
      <xacro:pos_joint name="J3" init="${ip['J3']}"/>
      <xacro:pos_joint name="J4" init="${ip['J4']}"/>
      <xacro:pos_joint name="J5" init="${ip['J5']}"/>
      <xacro:pos_joint name="J6" init="${ip['J6']}"/>
      <!-- mode:=mock uses FANUC's controller config (fanuc_hardware_interface/config/ros2_controllers.yaml), whose
           joint_trajectory_controller is fanuc_controllers/ScaledJointTrajectoryController. On top of the joint
           interfaces it claims two robot-status values that the real FANUC hardware interface provides:
             Status/collaborative_speed_scaling  multiplies the trajectory speed (1.0 = full programmed speed)
             Status/motion_possible              0.0 makes the controller abort every goal and hold position
           The GenericSystem mock has no robot, so it offers both as constant state values with the "everything
           OK" settings below. Without them the controller cannot be activated and the arm cannot move. -->
      <gpio name="Status">
        <state_interface name="collaborative_speed_scaling">
          <param name="initial_value">1.0</param>
        </state_interface>
        <state_interface name="motion_possible">
          <param name="initial_value">1.0</param>
        </state_interface>
      </gpio>
    </ros2_control>
  </xacro:macro>

  <!-- Sim: Gazebo Fortress + gz_ros2_control + L515-like RGB-D camera -->
  <xacro:macro name="gungnir_sim" params="initial_positions_file">
    <xacro:property name="ip" value="${xacro.load_yaml(initial_positions_file)['initial_positions']}"/>
    <ros2_control name="GazeboSimSystem" type="system">
      <hardware>
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </hardware>
      <xacro:pos_joint name="J1" init="${ip['J1']}"/>
      <xacro:pos_joint name="J2" init="${ip['J2']}"/>
      <xacro:pos_joint name="J3" init="${ip['J3']}"/>
      <xacro:pos_joint name="J4" init="${ip['J4']}"/>
      <xacro:pos_joint name="J5" init="${ip['J5']}"/>
      <xacro:pos_joint name="J6" init="${ip['J6']}"/>
    </ros2_control>

    <gazebo>
      <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>$(find gungnir)/config/ros2_controllers_sim.yaml</parameters>
      </plugin>
    </gazebo>

    <!-- 640x480, ~70 deg HFOV, 0.25-9 m. Depth is aligned to colour. -->
    <xacro:if value="$(arg sim_camera)">
    <gazebo reference="camera_link">
      <sensor name="rgbd_camera" type="rgbd_camera">
        <always_on>1</always_on>
        <update_rate>10</update_rate>
        <visualize>false</visualize>
        <topic>sim_camera</topic>
        <ignition_frame_id>camera_depth_optical_frame</ignition_frame_id>
        <camera>
          <horizontal_fov>1.2217</horizontal_fov>
          <image><width>640</width><height>480</height></image>
          <clip><near>0.25</near><far>9.0</far></clip>
          <depth_camera><clip><near>0.25</near><far>9.0</far></clip></depth_camera>
        </camera>
      </sensor>
    </gazebo>
    </xacro:if>
  </xacro:macro>
</robot>
