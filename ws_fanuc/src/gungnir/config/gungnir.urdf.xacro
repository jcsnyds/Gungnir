<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="gungnir">

  <!-- Hardware backend: mock | sim | real -->
  <xacro:arg name="mode" default="mock"/>
  <!-- Arm: any CRX with a macro in config/robots (crx3ia, crx5ia, crx10ia, crx10ia_l, crx20ia_l, crx30ia) -->
  <xacro:arg name="robot_model" default="crx30ia"/>
  <!-- false = leave the Gazebo camera sensor out (saves CPU when no simulated camera is wanted) -->
  <xacro:arg name="sim_camera" default="true"/>
  <xacro:property name="mode" value="$(arg mode)"/>
  <xacro:arg name="initial_positions_file"
             default="$(find gungnir)/config/initial_positions.yaml"/>

  <!-- Arguments read by FANUC's physical ros2_control macro -->
  <xacro:arg name="robot_ip" default="192.168.1.100"/>
  <xacro:arg name="rmi_port" default="16001"/>
  <xacro:arg name="stream_motion_port" default="60015"/>
  <xacro:arg name="gpio_configuration" default=""/>
  <xacro:arg name="payload_schedule" default="1"/>
  <xacro:arg name="out_cmd_interp_buff_target" default="8"/>
  <xacro:arg name="force_sensor_type" default="1"/>
  <xacro:arg name="motion_control" default="1"/>
  <xacro:arg name="encoding" default="UTF-8"/>

  <xacro:include filename="$(find gungnir)/config/gungnir_geometry.urdf.xacro"/>
  <xacro:include filename="$(find gungnir)/config/gungnir_backends.xacro"/>

  <xacro:if value="${mode == 'mock'}">
    <xacro:gungnir_mock initial_positions_file="$(arg initial_positions_file)"/>
  </xacro:if>
  <xacro:if value="${mode == 'sim'}">
    <xacro:gungnir_sim initial_positions_file="$(arg initial_positions_file)"/>
  </xacro:if>
  <xacro:if value="${mode == 'real'}">
    <xacro:include filename="$(find fanuc_hardware_interface)/config/crx_physical_ros2_control_macro.xacro"/>
    <xacro:crx_control name="$(arg robot_model)" prefix=""/>
  </xacro:if>
</robot>
