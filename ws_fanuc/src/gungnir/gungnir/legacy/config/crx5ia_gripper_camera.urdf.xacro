<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="crx5ia_gripper_camera">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import crx5ia_gripper_camera urdf file -->
    <xacro:include filename="$(find gungnir)/config/crx5ia_gripper_camera_geometry.urdf.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="crx5ia_gripper_camera.ros2_control.xacro" />


    <xacro:crx5ia_gripper_camera_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
