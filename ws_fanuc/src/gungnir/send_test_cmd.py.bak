#!/usr/bin/env python3
"""
AI Use Statement:
ChatGPT (OpenAI) was used to assist in modifying and debugging the Python code
for Cartesian path planning in MoveIt. AI assistance was used to implement
conversion from roll-pitch-yaw Euler angles to quaternion orientation,
generate Cartesian trajectories from user-defined poses, and execute
trajectories only when the planned path was sufficiently complete.

The code was adapted to use ROS 2 interfaces, including rclpy, the
GetCartesianPath service, and the ExecuteTrajectory action. The final
code was reviewed and incorporated into the project by the author.
"""

import argparse
import math
import sys

import rclpy
from rclpy.action import ActionClient
from rclpy.node import Node
from rclpy.utilities import remove_ros_args

from geometry_msgs.msg import Pose
from moveit_msgs.action import ExecuteTrajectory
from moveit_msgs.msg import MoveItErrorCodes
from moveit_msgs.srv import GetCartesianPath


# ============================================================================================================
# CUSTOM FUNCTIONS
# ============================================================================================================


class CartesianPathPlanner(Node):

  def __init__(self):
    super().__init__("cartesian_path_planner")

    # Robot configuration
    self.group_name = "manipulator"

    # Set these to the actual names in your robot configuration
    self.eef_link = "tcp_frame"
    self.reference_frame = "camera_depth_optical_frame"

    # Cartesian path settings
    self.eef_step = 0.01
    self.jump_threshold = 0.0

    # Execution velocity and acceleration scaling
    self.velocity_scaling = 0.2
    self.acceleration_scaling = 0.2

    # Create Cartesian path service client
    self.cartesian_client = self.create_client(
        GetCartesianPath, "/compute_cartesian_path"
    )

    # Create trajectory execution action client
    self.execute_client = ActionClient(
        self, ExecuteTrajectory, "/execute_trajectory"
    )

    self.get_logger().info("Cartesian path planner initialized")

  # --------------------------------------------------------------------------------------------------------
  # CARTESIAN PATH PLANNING
  # --------------------------------------------------------------------------------------------------------

  def plan_cartesian_path(self, target):
    """Plan a Cartesian path to a target end-effector pose.

    Args:
        target: [x, y, z, roll, pitch, yaw] Position in meters and Euler angles
          in radians.

    Returns:
        plan: The computed MoveIt trajectory. fraction: Fraction of the
        requested Cartesian path completed.
    """

    if len(target) != 6:
      raise ValueError("Target must contain [x, y, z, roll, pitch, yaw]")

    x, y, z, roll, pitch, yaw = map(float, target)

    # Create target pose
    target_pose = Pose()

    target_pose.position.x = x
    target_pose.position.y = y
    target_pose.position.z = z

    # Convert roll, pitch, yaw to quaternion
    cr = math.cos(roll / 2)
    sr = math.sin(roll / 2)

    cp = math.cos(pitch / 2)
    sp = math.sin(pitch / 2)

    cy = math.cos(yaw / 2)
    sy = math.sin(yaw / 2)

    target_pose.orientation.x = sr * cp * cy - cr * sp * sy
    target_pose.orientation.y = cr * sp * cy + sr * cp * sy
    target_pose.orientation.z = cr * cp * sy - sr * sp * cy
    target_pose.orientation.w = cr * cp * cy + sr * sp * sy

    # Create Cartesian path request
    request = GetCartesianPath.Request()

    request.header.frame_id = self.reference_frame
    request.header.stamp = self.get_clock().now().to_msg()

    request.group_name = self.group_name
    request.link_name = self.eef_link

    request.waypoints = [target_pose]

    request.max_step = self.eef_step
    request.jump_threshold = self.jump_threshold

    request.avoid_collisions = True

    request.max_velocity_scaling_factor = self.velocity_scaling
    request.max_acceleration_scaling_factor = self.acceleration_scaling

    # Wait for Cartesian path service
    if not self.cartesian_client.wait_for_service(timeout_sec=5.0):
      self.get_logger().error("Cartesian path service unavailable")
      return None, 0.0

    # Request Cartesian path
    self.get_logger().info("Computing Cartesian path...")

    future = self.cartesian_client.call_async(request)

    rclpy.spin_until_future_complete(self, future, timeout_sec=30.0)

    if not future.done():
      self.get_logger().error("Cartesian path planning timed out")
      return None, 0.0

    response = future.result()

    if response is None:
      self.get_logger().error("Cartesian path request failed")
      return None, 0.0

    # Print diagnostic information
    self.get_logger().info(f"MoveIt error code: {response.error_code.val}")

    self.get_logger().info(f"Cartesian fraction: {response.fraction}")

    self.get_logger().info(
        f"Trajectory points: {len(response.solution.joint_trajectory.points)}"
    )

    self.get_logger().info(f"Planning group: {self.group_name}")

    self.get_logger().info(f"End-effector link: {self.eef_link}")

    self.get_logger().info(f"Reference frame: {self.reference_frame}")

    if response.fraction == 0.0:
      self.get_logger().error(
          "No Cartesian path could be calculated. "
          "Check IK, target reachability, collisions, and robot state."
      )

    return response.solution, response.fraction

  # --------------------------------------------------------------------------------------------------------
  # TRAJECTORY EXECUTION
  # --------------------------------------------------------------------------------------------------------

  def execute_plan(self, plan):
    """Execute a previously computed Cartesian trajectory.

    Args:
        plan: MoveIt RobotTrajectory message.

    Returns:
        success: True if trajectory execution succeeded.
    """

    # Wait for trajectory execution action server
    if not self.execute_client.wait_for_server(timeout_sec=5.0):
      self.get_logger().error(
          "Trajectory execution action server unavailable"
      )
      return False

    # Create execution goal
    goal = ExecuteTrajectory.Goal()
    goal.trajectory = plan

    # Send trajectory for execution
    self.get_logger().info("Executing Cartesian trajectory...")

    future = self.execute_client.send_goal_async(goal)

    rclpy.spin_until_future_complete(self, future, timeout_sec=10.0)

    if not future.done():
      self.get_logger().error("Execution request timed out")
      return False

    goal_handle = future.result()

    if goal_handle is None or not goal_handle.accepted:
      self.get_logger().error("Trajectory execution rejected")
      return False

    # Wait for execution result
    result_future = goal_handle.get_result_async()

    rclpy.spin_until_future_complete(self, result_future, timeout_sec=120.0)

    if not result_future.done():
      self.get_logger().error("Trajectory execution timed out")
      return False

    result = result_future.result().result

    success = result.error_code.val == MoveItErrorCodes.SUCCESS

    if success:
      self.get_logger().info("Trajectory executed successfully")
    else:
      self.get_logger().error(
          f"Trajectory execution failed with error code:"
          f" {result.error_code.val}"
      )

    return success


# ============================================================================================================
# MAIN
# ============================================================================================================


def main(args=None):
  # Set up argument parser for positional arguments
  parser = argparse.ArgumentParser(
      description=(
          "Send Cartesian path target pose to MoveIt using positional"
          " arguments."
      )
  )
  parser.add_argument(
      "pose",
      nargs="*",
      type=float,
      help="Target pose values: x y z roll pitch yaw",
  )

  # Parse args while filtering out ROS-specific arguments
  parsed_args = parser.parse_args(remove_ros_args(sys.argv)[1:])

  # Default fallback pose if no arguments are provided
  default_pose = [0.0, 0.063, 0.066, 0.0, -math.pi / 2, math.pi / 2]

  if parsed_args.pose:
    if len(parsed_args.pose) != 6:
      parser.error(
          "You must provide exactly 6 positional arguments: x y z roll pitch yaw"
      )
    pose_goal = parsed_args.pose
  else:
    pose_goal = default_pose

  rclpy.init(args=args)

  planner = CartesianPathPlanner()

  try:
    planner.get_logger().info(
        f"Target Pose -> x: {pose_goal[0]}, y: {pose_goal[1]}, z:"
        f" {pose_goal[2]}, roll: {pose_goal[3]}, pitch: {pose_goal[4]}, yaw:"
        f" {pose_goal[5]}"
    )

    # Generate Cartesian path
    plan, fraction = planner.plan_cartesian_path(pose_goal)

    print(f"Path completion: {fraction * 100:.1f}%")

    # Execute only if the entire Cartesian path was successfully planned
    if plan is not None and fraction >= 0.999:
      success = planner.execute_plan(plan)
    else:
      success = False
      planner.get_logger().error(
          "Cartesian path planning was incomplete. " "Execution canceled."
      )

    print("Execution successful:", success)

  except Exception as error:
    planner.get_logger().error(f"Error: {error}")

  finally:
    planner.destroy_node()
    rclpy.shutdown()


if __name__ == "__main__":
  main()