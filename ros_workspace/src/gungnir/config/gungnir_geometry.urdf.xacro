<?xml version="1.0"?>
<robot name="crx5ia_gripper_camera" xmlns:xacro="http://ros.org">

  <!-- 1. Include the official FANUC CRX-5iA macro -->
  <xacro:include filename="$(find gungnir)/config/robots/$(arg robot_model)_urdf_macro.xacro"/>

  <!-- 2. Define world link and tool0 flange frame -->
  <link name="world" />
  <link name="tool0" />

  <!-- 3. Instantiate the CRX-5iA robot arm -->
  <!-- Note: The FANUC macro automatically connects the robot flange to 'tool0' -->
  <xacro:call macro="$(arg robot_model)" prefix="" parent="world" child="tool0">
    <origin xyz="0 0 0" rpy="0 0 0" />
  </xacro:call>

  <!-- ===================================================================== -->
  <!-- 4. Pneumatic Gripper (STL in mm -> scale="0.001 0.001 0.001")         -->
  <!-- ===================================================================== -->
  <link name="gripper">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 ${pi/2}" />
      <geometry>
        <mesh filename="package://gungnir/config/meshes/Pneumatic_Gripper_Test.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="gripper_gray">
        <color rgba="0.5 0.5 0.5 1.0" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 ${pi/2}" />
      <geometry>
        <mesh filename="package://gungnir/config/meshes/Pneumatic_Gripper_Test.stl" scale="0.001 0.001 0.001" />
      </geometry>
    </collision>
    <inertial>
      <mass value="1.5" />
      <origin xyz="0 0 0.1" rpy="0 0 ${pi/2}" />
      <inertia ixx="0.005" ixy="0.0" ixz="0.0" iyy="0.005" iyz="0.0" izz="0.002" />
    </inertial>
  </link>

  <joint name="gripper_joint" type="fixed">
    <parent link="tool0" />
    <child link="gripper" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>

  <!-- ===================================================================== -->
  <!-- 5. Tool Center Point (TCP) Frame                                      -->
  <!-- ===================================================================== -->
  <link name="tcp_frame" />

  <joint name="tcp_joint" type="fixed">
    <parent link="tool0" />
    <child link="tcp_frame" />
    <!-- tcp_frame: 0.3 m along the tool axis (tool0 +X). Its z axis is the tool axis; its x and y are
         rotated 180 deg about z relative to camera_depth_optical_frame (this rpy encodes that).
         Adjust the origin to match your physical tool tip. -->
    <origin xyz="0.3 0 0" rpy="${pi/2} 0 ${pi/2}" />
  </joint>

  <!-- ===================================================================== -->
  <!-- 6. Intel RealSense L515 Depth Camera (relative to tool0)              -->
  <!--    Offset in tool0: 243.924 mm along the tool axis (+X), 62.525 mm along +Z   -->
  <!-- ===================================================================== -->
  <joint name="l515_mount_joint" type="fixed">
    <parent link="tool0" />
    <child link="camera_link" />
    <!-- Adjust rpy (in radians) to match the physical orientation of your camera -->
    <origin xyz=" 0.243924 0.000 0.062525" rpy="0 0 0" />
  </joint>

  <link name="camera_link">
    <visual>
      <!-- Cylinder rotated so flat face points forward along +X of camera_link -->
      <origin xyz="0 0 0" rpy="0 ${pi/2} 0" />
      <geometry>
        <cylinder radius="0.0305" length="0.0254" />
      </geometry>
      <material name="l515_black">
        <color rgba="0.1 0.1 0.1 0.25" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 ${pi/2} 0" />
      <geometry>
        <cylinder radius="0.0305" length="0.026" />
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1" />
      <origin xyz="0 0 0" rpy="0 0 0" />
      <inertia ixx="0.00003" ixy="0" ixz="0" iyy="0.00003" iyz="0" izz="0.00005" />
    </inertial>
  </link>

  <!-- Standard ROS Optical Frame (Z forward, X right, Y down) required for depth point clouds -->
  <joint name="camera_depth_optical_joint" type="fixed">
    <parent link="camera_link" />
    <child link="camera_depth_optical_frame" />
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}" />
  </joint>

  <link name="camera_depth_optical_frame" />

</robot>
